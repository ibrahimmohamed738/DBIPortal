@model DBI_eDahab.Web.ViewModels.UpdateLimitRequest
@{
    ViewBag.Title = "Update Customer Limit";
}

<div class="container">

    @using (Html.BeginForm())
    {


        <div class="form-horizontal">
            <h4> </h4>
            @if (TempData["SuccessMessage"] != null)
            {
                <h4 class="alert alert-success"> @TempData["SuccessMessage"]</h4>
            }

            @if (TempData["Error"] != null)
            {
                <h4 class="alert alert-danger"> @TempData["Error"]</h4>
            }

            <hr />
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title">Update Customer Limit</h3>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-lg-8">
                            <div class="form-group">
                                @Html.LabelFor(model => model.AccountNo, new { @class = "col-md-2 control-label" })
                                <div class="col-md-8">
                                    @Html.TextBoxFor(model => model.AccountNo, new { @class = "form-control", autocomplete = "off", placeholder = "Account No" })
                                    @Html.ValidationMessageFor(model => model.AccountNo, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.NewLimit, new { @class = "col-md-2 control-label" })
                                <div class="col-md-8">
                                    @Html.TextBoxFor(model => model.NewLimit, new { @class = "form-control", autocomplete = "off", placeholder = "New Limit" })
                                    @Html.ValidationMessageFor(model => model.NewLimit, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <br />
                    <div class="panel-footer">
                        <div class="form-group">
                            <div class="col-md-offset-1 col-md-8">
                                <input type="submit" value="Update Limit" name="submitButton" class="btn btn-success" />
                            </div>
                        </div>
                    </div>
                </div>
        </div>
</div>
    }
</div>
