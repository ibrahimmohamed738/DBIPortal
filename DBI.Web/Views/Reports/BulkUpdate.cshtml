@{
    ViewBag.Title = "Bulk Update";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="http://ajax.googleapis.com/ajax/libs/jquery/1/jquery.min.js"></script>

<script src="~/Scripts/jquery-2.0.3.min.js"></script>

<br />


<div class="container">
    <div class="form-horizontal">


        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="panel panel-info">
            <div class="panel-heading">
                <h3 class="panel-title">Bulk Update</h3>
            </div>
            <div class="panel-body">

                <div class="row">
                    <br />

                    @if (ViewBag.Message != null)
                    {
                        <p class="alert alert-info"> @ViewBag.Message</p>
                    }


                    <form action="/Reports/BulkUpdate" method="post" enctype="multipart/form-data" class="row g-3">
                        <div class="form-group">
                            <div class="mb-3">
                                <label for="file" class="form-label">Upload File</label>
                                <input class="form-control" type="file" name="file" accept=".xlsx" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <button type="submit" class="btn btn-primary mb-3">Upload</button>
                            <a href="/Reports/DownloadTemplate" class="btn btn-info pull-right">Download Excel Template</a>
                        </div>

                    </form>

                </div>
            </div>

</div>
</div>
</div>